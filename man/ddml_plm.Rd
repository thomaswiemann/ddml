plm_fit <- ddml_plm(y, D, X,
                    learners = list(list(what = ols),
                                    list(what = mdl_glmnet),
                                    list(what = mdl_glmnet,
                                         args = list(alpha = 0))),
                    ensemble_type = 'nnls',
